@baseUrl = http://localhost:9090/api/v1

# --------------------------------------------
# Replace these variables with real IDs from
# the seed output before running requests.
#
# NB! Run the seed script first (npm run seed), then replace the
# IDs below with new ones from the seed.
# --------------------------------------------
@userId      = user_FKovZs6mY8
@userId2     = user_RgSXkAAIqa
@matchId     = match_p4Hv10fsjR
@tournamentId = tournament_kAvtXLngPH
@gameCatId   = game_2uyTZFDeAe
@trophyId    = trophy_4Fwr6z-VdF


###
# --------------------------------------------
#  USERS
# --------------------------------------------

### Get all users
GET {{baseUrl}}/users

### Get a single user by ID
GET {{baseUrl}}/users/{{userId}}

### Get all matches for a user
GET {{baseUrl}}/users/{{userId}}/matches

### Get a user's 10 most recent games
GET {{baseUrl}}/users/{{userId}}/recent-games

### Get a user's stats (wins, losses, ELO, win%)
GET {{baseUrl}}/users/{{userId}}/stats

### Get a user's won trophies
GET {{baseUrl}}/users/{{userId}}/trophies


###
# --------------------------------------------
#  GAME CATEGORIES
# --------------------------------------------

### Get all game categories
GET {{baseUrl}}/game-categories

### Get a game category by ID
GET {{baseUrl}}/game-categories/{{gameCatId}}

### Get a game category by name (use %20 for spaces)
GET {{baseUrl}}/game-categories/by-name?name=Quick%20Play


###
# --------------------------------------------
#  MATCHES
# --------------------------------------------

### Get all matches
GET {{baseUrl}}/matches

### Get all matches filtered by visibility
GET {{baseUrl}}/matches?visibility=public

### Get all matches filtered by a specific player
GET {{baseUrl}}/matches?player={{userId}}

### Get all matches filtered by game type
GET {{baseUrl}}/matches?gameType={{gameCatId}}

### Get a single match by ID
GET {{baseUrl}}/matches/{{matchId}}

### Spectate a match (public matches only)
GET {{baseUrl}}/matches/{{matchId}}/spectate

### Get all comments on a match
GET {{baseUrl}}/matches/{{matchId}}/comments


###
# --------------------------------------------
#  MATCHMAKING
# --------------------------------------------

### Poll matchmaking status for a user
GET {{baseUrl}}/matchmaking/status/{{userId}}
X-User-Type: registered
X-User-Id: {{userId}}

### Get queue snapshot (admin only)
GET {{baseUrl}}/matchmaking/queue
X-User-Type: admin
X-User-Id: {{userId}}


###
# --------------------------------------------
#  TOURNAMENTS
# --------------------------------------------

### Get all tournaments
GET {{baseUrl}}/tournaments

### Get tournaments filtered by status
GET {{baseUrl}}/tournaments?status=pending

### Get tournaments filtered by type
GET {{baseUrl}}/tournaments?tournamentType=knockout

### Get a single tournament by ID
GET {{baseUrl}}/tournaments/{{tournamentId}}

### Get tournament standings (knockout rounds or arena scores)
GET {{baseUrl}}/tournaments/{{tournamentId}}/standings

### Get all matches belonging to a tournament
GET {{baseUrl}}/tournaments/{{tournamentId}}/matches

### Get all comments on a tournament
GET {{baseUrl}}/tournaments/{{tournamentId}}/comments


###
# --------------------------------------------
#  COMMENTS  (admin only)
# --------------------------------------------

### Get all comments (paginated)
GET {{baseUrl}}/comments
X-User-Type: admin
X-User-Id: {{userId}}

### Get comments filtered by type and paginated
GET {{baseUrl}}/comments?commentType=match&limit=10&offset=0
X-User-Type: admin
X-User-Id: {{userId}}


###
# --------------------------------------------
#  LEADERBOARDS
# --------------------------------------------

### Global leaderboard (sorted by ELO, paginated)
GET {{baseUrl}}/leaderboards

### Global leaderboard with custom pagination
GET {{baseUrl}}/leaderboards?limit=3&offset=0

### Get a specific user's rank and stats
GET {{baseUrl}}/leaderboards/user/{{userId}}

### Leaderboard filtered by user type
GET {{baseUrl}}/leaderboards/type?userType=registered

### Weekly leaderboard (sorted by ELO change this week)
GET {{baseUrl}}/leaderboards/weekly

### Top N players (default 10)
GET {{baseUrl}}/leaderboards/top

### Top N players with custom count
GET {{baseUrl}}/leaderboards/top?count=3

### Compare two players head-to-head
GET {{baseUrl}}/leaderboards/compare?uid1={{userId}}&uid2={{userId2}}


###
# --------------------------------------------
#  TROPHIES
# --------------------------------------------

### Get all trophies
GET {{baseUrl}}/trophies

### Get a single trophy by ID
GET {{baseUrl}}/trophies/{{trophyId}}


###
# --------------------------------------------
#  PLATFORM STATS
# --------------------------------------------

### Get platform activity (active users, recent matches, totals)
GET {{baseUrl}}/stats/platform


###
# --------------------------------------------
#  ADMIN
# --------------------------------------------

### Search all users by username
GET {{baseUrl}}/admin/users?username=pro
X-User-Type: admin
X-User-Id: {{userId}}

### Search users filtered by type
GET {{baseUrl}}/admin/users?userType=registered
X-User-Type: admin
X-User-Id: {{userId}}

### Search users by username and type combined
GET {{baseUrl}}/admin/users?username=player&userType=registered
X-User-Type: admin
X-User-Id: {{userId}}
