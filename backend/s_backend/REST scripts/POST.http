@baseUrl = http://localhost:9090/api/v1

# --------------------------------------------
# Replace these variables with real IDs from
# the seed output before running requests.
#
# NB! Run the seed script first (npm run seed), then replace the
# IDs below with new ones from the seed.
# --------------------------------------------
@userId         = user_FKovZs6mY8
@userId2        = user_8LBFAWqGPH
@matchId        = match_bz0z-7ai_T
@pendingMatchId = match_eQkV1CkHwm
@tournamentId   = tournament_AEINnKxG8U
@gameCatId      = game_IrZrfaxyNC
@trophyId       = trophy_4Fwr6z-VdF


###
# --------------------------------------------
#  USERS
# --------------------------------------------

### Create a registered user (no auth required for registration)
POST {{baseUrl}}/users
Content-Type: application/json

{
  "username": "new_player",
  "age": 24,
  "userType": "registered"
}

###

### Create an admin user
POST {{baseUrl}}/users
Content-Type: application/json

{
  "username": "new_admin",
  "age": 30,
  "userType": "admin"
}

###

### Create an anonymous user
POST {{baseUrl}}/users
Content-Type: application/json

{
  "username": "anon_player",
  "age": 20,
  "userType": "anonymous"
}

###

### Create a user — underage (expect 400)
POST {{baseUrl}}/users
Content-Type: application/json

{
  "username": "too_young",
  "age": 16
}


###
# --------------------------------------------
#  GAME CATEGORIES  (admin only)
# --------------------------------------------

### Create a new game category
POST {{baseUrl}}/game-categories
Content-Type: application/json
X-User-Type: admin
X-User-Id: {{userId}}

{
  "name": "Blitz Mode",
  "numOfRounds": 3,
  "straightsAllowed": false,
  "timePerRound": 3
}

###

### Create a game category — invalid numOfRounds (expect 400)
POST {{baseUrl}}/game-categories
Content-Type: application/json
X-User-Type: admin
X-User-Id: {{userId}}

{
  "name": "Bad Category",
  "numOfRounds": 4,
  "straightsAllowed": true,
  "timePerRound": 10
}


###
# --------------------------------------------
#  MATCHES
# --------------------------------------------

### Create a new match between two players
POST {{baseUrl}}/matches
Content-Type: application/json
X-User-Type: registered
X-User-Id: {{userId}}

{
  "player1": "{{userId}}",
  "player2": "{{userId2}}",
  "gameType": "{{gameCatId}}",
  "visibility": "public"
}

###

### Create a pending match (no player2 yet)
POST {{baseUrl}}/matches
Content-Type: application/json
X-User-Type: registered
X-User-Id: {{userId}}

{
  "player1": "{{userId}}",
  "player2": null,
  "gameType": "{{gameCatId}}",
  "visibility": "public"
}

###

### Save the result of a match (player1 wins)
POST {{baseUrl}}/matches/{{matchId}}/result
Content-Type: application/json
X-User-Type: registered
X-User-Id: {{userId}}

{
  "player1Score": 3,
  "player2Score": 1
}

###

### Save the result of a match (player2 wins)
POST {{baseUrl}}/matches/{{matchId}}/result
Content-Type: application/json
X-User-Type: registered
X-User-Id: {{userId}}

{
  "player1Score": 0,
  "player2Score": 4
}

###

### Save result — tied scores (expect 400)
POST {{baseUrl}}/matches/{{matchId}}/result
Content-Type: application/json
X-User-Type: registered
X-User-Id: {{userId}}

{
  "player1Score": 2,
  "player2Score": 2
}

###

### Invite a user to a match
POST {{baseUrl}}/matches/{{pendingMatchId}}/invite
Content-Type: application/json
X-User-Type: registered
X-User-Id: {{userId}}

{
  "invitedUserId": "{{userId2}}"
}

###

### Join a match as player 2
POST {{baseUrl}}/matches/{{pendingMatchId}}/join
Content-Type: application/json
X-User-Type: registered
X-User-Id: {{userId2}}

{
  "userId": "{{userId2}}"
}

###

### Post a comment on a match
POST {{baseUrl}}/matches/{{matchId}}/comments
Content-Type: application/json
X-User-Type: registered
X-User-Id: {{userId}}

{
  "author": "{{userId}}",
  "content": "Great game, well played!"
}


###
# --------------------------------------------
#  MATCHMAKING
# --------------------------------------------

### Join the matchmaking queue
POST {{baseUrl}}/matchmaking/join
Content-Type: application/json
X-User-Type: registered
X-User-Id: {{userId}}

{
  "userId": "{{userId}}",
  "gameCategory": "{{gameCatId}}"
}


###
# --------------------------------------------
#  TOURNAMENTS
# --------------------------------------------

### Create a knockout tournament
POST {{baseUrl}}/tournaments
Content-Type: application/json
X-User-Type: admin
X-User-Id: {{userId}}

{
  "title": "Autumn Knockout Cup",
  "description": "A competitive knockout tournament.",
  "tournamentType": "knockout",
  "gameCategory": "{{gameCatId}}",
  "startDateTime": "2026-09-01T10:00:00Z",
  "createdBy": "{{userId}}"
}

###

### Create an arena tournament
POST {{baseUrl}}/tournaments
Content-Type: application/json
X-User-Type: admin
X-User-Id: {{userId}}

{
  "title": "Friday Night Arena",
  "description": "60-minute arena brawl.",
  "tournamentType": "arena",
  "gameCategory": "{{gameCatId}}",
  "startDateTime": "2026-09-05T18:00:00Z",
  "durationMinutes": 60,
  "createdBy": "{{userId}}"
}

###

### Create tournament — missing required fields (expect 400)
POST {{baseUrl}}/tournaments
Content-Type: application/json
X-User-Type: admin
X-User-Id: {{userId}}

{
  "title": "Incomplete Tournament"
}

###

### Join a tournament
POST {{baseUrl}}/tournaments/{{tournamentId}}/join
Content-Type: application/json
X-User-Type: registered
X-User-Id: {{userId}}

{
  "userId": "{{userId}}"
}

###

### Leave a tournament
POST {{baseUrl}}/tournaments/{{tournamentId}}/leave
Content-Type: application/json
X-User-Type: registered
X-User-Id: {{userId}}

{
  "userId": "{{userId}}"
}

###

### Generate round 1 pairings for a knockout tournament
POST {{baseUrl}}/tournaments/{{tournamentId}}/pairings
X-User-Type: admin
X-User-Id: {{userId}}

###

### Advance a knockout tournament to the next round
POST {{baseUrl}}/tournaments/{{tournamentId}}/advance
X-User-Type: admin
X-User-Id: {{userId}}

###

### Start an arena tournament
POST {{baseUrl}}/tournaments/{{tournamentId}}/arena-start
X-User-Type: admin
X-User-Id: {{userId}}

###

### Advance arena tournament to the next round (or close if time is up)
POST {{baseUrl}}/tournaments/{{tournamentId}}/arena-advance
X-User-Type: admin
X-User-Id: {{userId}}

###

### Record an arena match result (awards 1 point to the winner)
POST {{baseUrl}}/tournaments/{{tournamentId}}/arena-result
Content-Type: application/json
X-User-Type: registered
X-User-Id: {{userId}}

{
  "matchId": "{{matchId}}",
  "player1Score": 3,
  "player2Score": 1
}

###

### Post a comment on a tournament
POST {{baseUrl}}/tournaments/{{tournamentId}}/comments
Content-Type: application/json
X-User-Type: registered
X-User-Id: {{userId}}

{
  "author": "{{userId}}",
  "content": "Looking forward to this tournament!"
}


###
# --------------------------------------------
#  TROPHIES
# --------------------------------------------

### Create a trophy (JSON body, no image)
POST {{baseUrl}}/trophies
Content-Type: application/json
X-User-Type: admin
X-User-Id: {{userId}}

{
  "title": "Grand Champion Trophy",
  "tournamentId": "{{tournamentId}}"
}

###

### Upload a trophy image only (multipart/form-data, field name "image")
# Use curl: curl -X POST http://localhost:9090/api/v1/trophies/upload -F "image=@/path/to/image.png"
POST {{baseUrl}}/trophies/upload
X-User-Type: admin
X-User-Id: {{userId}}
