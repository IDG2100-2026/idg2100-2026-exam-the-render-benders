@baseUrl = http://localhost:3000/api/v1
@contentType = application/json

### Register a new user
POST {{baseUrl}}/users
Content-Type: {{contentType}}

{
    "username": "testuser",
    "email": "test@example.com",
    "pwd": "password123",
    "dateOfBirth": "1995-06-15"
}

# @name login
POST {{baseUrl}}/users/login
Content-Type: {{contentType}}

{
    "username": "carlos88",
    "password": "password123"
}

@userId = {{login.response.body._id}}

GET {{baseUrl}}/users/carlos88
x-user-type: user
x-user-id: {{userId}}

GET {{baseUrl}}/users
x-user-type: user

PATCH {{baseUrl}}/users/carlos88/preferences
Content-Type: {{contentType}}
x-user-type: user
x-user-id: {{userId}}

{
    "theme": "dark",
    "boardColor": "#1a1a2e",
    "sound": true,
    "lobbyCount": 5
}

GET {{baseUrl}}/leaderboard?sortBy=elo
x-user-type: anonymous

GET {{baseUrl}}/leaderboard?sortBy=wins
x-user-type: anonymous

GET {{baseUrl}}/games?status=waiting
x-user-type: user
x-user-id: {{userId}}

GET {{baseUrl}}/games?status=waiting
x-user-type: anonymous
GET {{baseUrl}}/games/top
x-user-type: anonymous

POST {{baseUrl}}/games
Content-Type: {{contentType}}
x-user-type: user
x-user-id: {{userId}}

{
    "players": ["{{userId}}"],
    "variant": {
        "rounds": 3,
        "rules": "straights-allowed",
        "timeControl": 10
    },
    "allowAnonymous": true,
    "desiredElo": 1200
}

PATCH {{baseUrl}}/games/GAME_ID/join
Content-Type: {{contentType}}
x-user-type: user
x-user-id: {{userId}}

{
    "player": "{{userId}}"
}

GET {{baseUrl}}/games/GAME_ID/comments
x-user-type: anonymous

POST {{baseUrl}}/comments
Content-Type: {{contentType}}
x-user-type: user
x-user-id: {{userId}}

{
    "body": "Great game!",
    "author": "{{userId}}",
    "game": "GAME_ID"
}

GET {{baseUrl}}/tournaments
x-user-type: anonymous

GET {{baseUrl}}/tournaments/TOURNAMENT_ID
x-user-type: anonymous

PATCH {{baseUrl}}/tournaments/TOURNAMENT_ID/join
Content-Type: {{contentType}}
x-user-type: user
x-user-id: {{userId}}

{
    "player": "{{userId}}"
}

GET {{baseUrl}}/tournaments/TOURNAMENT_ID/comments
x-user-type: anonymous

GET {{baseUrl}}/activity
x-user-type: anonymous
